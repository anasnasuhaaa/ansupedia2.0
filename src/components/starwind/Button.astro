---
import Button from '@starwind-ui/astro/button';
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'button'> & { variant?: 'primary' | 'secondary' };
const { variant = 'primary', class: className, ...props } = Astro.props;
---
<Button.Root class:list={['button', variant, className]} {...props}><slot /></Button.Root>
