---
import { technologyIcons } from '../../data/skills';
import Badge from '../starwind/badge/Badge.astro';
interface Props {
  name: string;
}
const { name } = Astro.props;
const icon = technologyIcons[name];
---

<Badge variant="outline" class="tech-tag">
  {icon && (
    <span class="tech-icon" style={`mask-image:url(/icons/${icon}.svg)`} aria-hidden="true" />
  )}
  {name}
</Badge>
