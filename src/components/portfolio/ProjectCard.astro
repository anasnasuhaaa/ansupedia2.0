---
import type { Project } from '../../data/projects';
import Card from '../starwind/card';
import Button from '../starwind/button/Button.astro';
import Github from '@tabler/icons/outline/brand-github.svg';
import Arrow from '@tabler/icons/outline/arrow-up-right.svg';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const destination = project.liveUrl || project.githubUrl;
---

<article
  class:list={{ 'project-lead': project.featured && !project.image.endsWith('.svg') }}
  aria-labelledby={`project-${project.id}`}
>
  <Card.Root class="project-card ring-0">
    <div class:list={['project-cover', { 'project-title-cover': project.image.endsWith('.svg') }]}>
      <img src={project.image} alt={project.imageAlt} width="800" height="500" loading="lazy" />
    </div>
    <Card.Content class="project-body">
      <h3 id={`project-${project.id}`}>
        <a href={destination}>{project.name}</a>
      </h3>
      <p>{project.description}</p>
      <ul class="tags project-technologies" aria-label="Technologies">
        {project.technologies.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </Card.Content>
    <Card.Footer class="project-links">
      {project.githubUrl && (
        <Button
          href={project.githubUrl}
          variant="ghost"
          size="sm"
          aria-label={`View ${project.name} source on GitHub`}
        >
          <Github aria-hidden="true" /> <span>Source code</span>
        </Button>
      )}
      {project.liveUrl && (
        <Button
          href={project.liveUrl}
          variant="ghost"
          size="sm"
          aria-label={`Visit ${project.name}`}
        >
          <span>Visit website</span> <Arrow aria-hidden="true" />
        </Button>
      )}
    </Card.Footer>
  </Card.Root>
</article>
