---
import Badge from '../../components/starwind/badge/Badge.astro';
import Prose from '../../components/starwind/prose/Prose.astro';
import ArrowLeft from '@tabler/icons/outline/arrow-left.svg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';
import { getPost, relatedPosts } from '../../db/queries/blog';
import { renderContent, readingTime } from '../../lib/blog/content';
const post = await getPost(Astro.params.slug!);
if (!post) {
  Astro.response.status = 404;
}
const related = post
  ? await relatedPosts(
      post.id,
      post.categories.map((c) => c.id),
    )
  : [];
const html = post ? renderContent(post.contentJson) : '';
const site = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
---

<BaseLayout
  title={post ? `${post.seoTitle || post.title} — Ansupedia` : 'Article not found — Ansupedia'}
  description={post?.seoDescription || post?.excerpt}
  image={post?.coverImageUrl}
  noindex={!post}
  article
>
  <div class="page article-page">
    <div class="reading-width">
      <a class="text-link article-back" href="/blog">
        <ArrowLeft aria-hidden="true" /> Back to blog
      </a>
      {post ? (
        <>
          <header class="page-heading article-heading">
            {post.categories.length > 0 && (
              <div class="tags">
                {post.categories.map((c) => (
                  <Badge
                    variant="outline"
                    class="category-badge"
                    href={`/blog?${new URLSearchParams({ category: c.slug })}`}
                  >
                    {c.name}
                  </Badge>
                ))}
              </div>
            )}
            <h1>{post.title}</h1>
            {post.excerpt && <p class="article-excerpt">{post.excerpt}</p>}
            <div class="meta article-meta">
              <time datetime={post.publishedAt?.toISOString()}>
                {post.publishedAt?.toLocaleDateString('en-US', { dateStyle: 'long' })}
              </time>
              <span aria-hidden="true">·</span>
              <span>{readingTime(post.contentJson)} min read</span>
              {post.publishedAt &&
                post.updatedAt.getTime() - post.publishedAt.getTime() > 86400000 && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      Updated{' '}
                      <time datetime={post.updatedAt.toISOString()}>
                        {post.updatedAt.toLocaleDateString('en-US')}
                      </time>
                    </span>
                  </>
                )}
            </div>
          </header>
          {post.coverImageUrl && (
            <img
              class="cover"
              src={post.coverImageUrl}
              alt={post.coverImageAlt || ''}
              width="1200"
              height="675"
            />
          )}
          <article>
            <Prose class="prose article-prose">
              <Fragment set:html={html} />
            </Prose>
          </article>
          {related.length > 0 && (
            <section class="section related-section">
              <h2>Keep reading</h2>
              <div class="related-writing">
                {related.map((post) => (
                  <PostRow post={post} />
                ))}
              </div>
            </section>
          )}
          <script
            type="application/ld+json"
            set:html={JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'BlogPosting',
              headline: post.title,
              description: post.excerpt,
              datePublished: post.publishedAt?.toISOString(),
              dateModified: post.updatedAt.toISOString(),
              image: post.coverImageUrl || undefined,
              author: { '@type': 'Person', name: 'Anas Nasuha', url: site },
              mainEntityOfPage: new URL(`/blog/${post.slug}`, site).href,
            }).replace(/</g, '\\u003c')}
          />
        </>
      ) : (
        <>
          <h1 class="article-not-found">Page not found.</h1>
          <p>This article is unavailable or hasn't been published.</p>
        </>
      )}
    </div>
  </div>
</BaseLayout>
