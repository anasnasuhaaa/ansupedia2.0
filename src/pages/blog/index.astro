---
import Input from '../../components/starwind/input/Input.astro';
import Button from '../../components/starwind/button/Button.astro';
import Badge from '../../components/starwind/badge/Badge.astro';
import Search from '@tabler/icons/outline/search.svg';
import Notebook from '@tabler/icons/outline/notebook.svg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';
import PagePagination from '../../components/site/PagePagination.astro';
import { listPosts, listCategories, featuredPost } from '../../db/queries/blog';
const q = (Astro.url.searchParams.get('q') || '').slice(0, 200);
const category = Astro.url.searchParams.get('category') || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
let failed = false;
let result: Awaited<ReturnType<typeof listPosts>> = { items: [], total: 0, page: 1, pages: 1 };
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let featured: Awaited<ReturnType<typeof featuredPost>> = null;
try {
  [result, categories, featured] = await Promise.all([
    listPosts({ q, category, page }),
    listCategories(),
    featuredPost(),
  ]);
} catch {
  console.error('Public article listing failed');
  failed = true;
  Astro.response.status = 503;
}
const filterUrl = (category: string, page?: number) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category) params.set('category', category);
  if (page && page > 1) params.set('page', String(page));
  return `/blog${params.size ? `?${params}` : ''}`;
};
const showFeatured = featured && !q && !category && result.page === 1;
---

<BaseLayout
  title="Ansupedia's Blog — Ansupedia"
  description="Notes on software engineering, cybersecurity, and learning by building."
>
  <div class="page blog-page">
    <header class="page-heading blog-heading">
      <h1>Ansupedia's Blog</h1>
    </header>
    <div class="blog-filter-panel">
      <form class="filters blog-search" action="/blog" role="search">
        <div class="search-field">
          <Search class="size-4" aria-hidden="true" />
          <label class="sr-only" for="search">
            Search articles
          </label>
          <Input
            id="search"
            type="search"
            name="q"
            placeholder="Find something to read…"
            value={q}
            maxlength="200"
          />
        </div>
        {category && <input type="hidden" name="category" value={category} />}
        <Button type="submit" size="sm">
          Search
        </Button>
        {(q || category) && (
          <Button href="/blog" variant="ghost" size="sm">
            Clear filters
          </Button>
        )}
      </form>
      <nav class="category-filters" aria-label="Article categories">
        <Badge
          href={filterUrl('')}
          variant="outline"
          class:list={['category-chip', { selected: !category }]}
          aria-current={!category ? 'page' : undefined}
        >
          All Articles
        </Badge>
        {categories.map((c) => (
          <Badge
            href={filterUrl(c.slug)}
            variant="outline"
            class:list={['category-chip', { selected: category === c.slug }]}
            aria-current={category === c.slug ? 'page' : undefined}
          >
            {c.name}
          </Badge>
        ))}
      </nav>
    </div>
    {showFeatured && featured && <PostRow post={featured} featured />}
    <div class="writing-heading">
      <h2>{q || category ? 'Search results' : 'All writing'}</h2>
      <span class="meta">
        {result.total} {result.total === 1 ? 'article' : 'articles'}
        {q && ` matching “${q}”`}
      </span>
    </div>
    {failed ? (
      <div class="notice" role="status">
        Writing is temporarily unavailable. Please try again later.
      </div>
    ) : result.items.length ? (
      <div class="writing-grid">
        {result.items
          .filter((post) => !showFeatured || post.id !== featured?.id)
          .map((post) => (
            <PostRow post={post} />
          ))}
      </div>
    ) : (
      <div class="empty blog-empty">
        <span class="empty-icon">
          <Notebook class="size-5" aria-hidden="true" />
        </span>
        <h2>{q || category ? 'No matching notes.' : 'A fresh page.'}</h2>
        <p>
          {q || category
            ? 'Try another search or explore a different category.'
            : 'Articles will appear here as they are published. There is always something new to learn.'}
        </p>
        {(q || category) && (
          <Button href="/blog" variant="outline" size="sm">
            Show all articles
          </Button>
        )}
      </div>
    )}
    <PagePagination
      page={result.page}
      pages={result.pages}
      pageUrl={(page) => filterUrl(category, page)}
    />
  </div>
</BaseLayout>
