---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';
import { listPosts,listCategories,featuredPost } from '../../db/queries/blog';
const q=(Astro.url.searchParams.get('q')||'').slice(0,200);const category=Astro.url.searchParams.get('category')||'';const page=Math.max(1,Number(Astro.url.searchParams.get('page'))||1);
let failed=false;let result:Awaited<ReturnType<typeof listPosts>>={items:[],total:0,page:1,pages:1};let categories:Awaited<ReturnType<typeof listCategories>>=[];let featured:Awaited<ReturnType<typeof featuredPost>>=null;
try{[result,categories,featured]=await Promise.all([listPosts({q,category,page}),listCategories(),featuredPost()]);}catch{console.error('Public article listing failed');failed=true;Astro.response.status=503;}
const pageUrl=(page:number)=>`/blog?${new URLSearchParams({q,category,page:String(page)})}`;
---
<BaseLayout title="Writing — Ansupedia" description="Notes on software engineering, cybersecurity, and learning by building."><div class="page narrow"><div class="page-heading"><span class="eyebrow">The notebook</span><h1>Learning in public.</h1><p>Notes on software, security, and figuring things out.</p></div>{featured&&!q&&!category&&page===1&&<section class="notice"><span class="eyebrow">Featured article</span><PostRow post={featured}/></section>}<form class="filters" action="/blog"><label class="sr-only" for="search">Search articles</label><input id="search" type="search" name="q" placeholder="Search articles…" value={q}/><label class="sr-only" for="category">Category</label><select name="category" id="category"><option value="">All categories</option>{categories.map(c=><option value={c.slug} selected={category===c.slug}>{c.name}</option>)}</select><button class="button primary" type="submit">Search</button></form>{failed?<div class="notice" role="status">Writing is temporarily unavailable. Please try again later.</div>:result.items.length?result.items.map(post=><PostRow post={post}/>):<div class="empty"><h2>{q||category?'No matching notes.':'A fresh page.'}</h2><p>{q||category?'Try a different search or category.':'Articles will appear here as they are published. There is always something new to learn.'}</p>{(q||category)&&<a href="/blog">Clear filters</a>}</div>}{result.pages>1&&<nav class="pagination" aria-label="Pagination">{page>1?<a href={pageUrl(page-1)}>← Previous</a>:<span/>}<span class="meta">Page {page} of {result.pages}</span>{page<result.pages&&<a href={pageUrl(page+1)}>Next →</a>}</nav>}</div></BaseLayout>
