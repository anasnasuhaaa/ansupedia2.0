---
import Notebook from '@tabler/icons/outline/notebook.svg';
import Button from '../components/starwind/button/Button.astro';
import Grid from '@tabler/icons/outline/layout-grid.svg';
import Mail from '@tabler/icons/outline/mail.svg';
import IdentityIllustration from '../components/portfolio/IdentityIllustration.astro';
import ProjectGallery from '../components/portfolio/ProjectGallery.astro';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Github from '@tabler/icons/outline/brand-github.svg';
import Linkedin from '@tabler/icons/outline/brand-linkedin.svg';
import { databaseConfigured } from '../lib/env';
import { listPosts } from '../db/queries/blog';
import PostRow from '../components/blog/PostRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubStats from '../components/portfolio/GitHubStats.astro';
import TechTag from '../components/portfolio/TechTag.astro';
import { profile } from '../data/profile';
import { skills } from '../data/skills';
import { experiences } from '../data/experiences';
import { certifications } from '../data/certifications';
let recent: Awaited<ReturnType<typeof listPosts>>['items'] = [];
let blogError = false;
try {
  if (!databaseConfigured()) throw new Error('Blog database unavailable');
  recent = (await listPosts({ limit: 3 })).items;
} catch {
  console.error('Recent articles unavailable');
  blogError = true;
}
---

<BaseLayout>
  <div class="portfolio">
    <section id="about" class="hero">
      <div class="hero-heading">
        <div class="hero-identity">
          <h1>{profile.name}<span class="identity-period" aria-hidden="true">.</span></h1>
          <p class="hero-heading-detail">Software engineering<br /><em>&amp; cybersecurity.</em></p>
          <p class="intro-copy">{profile.introduction}</p>
          <div class="actions">
            <Button href="#projects"><Grid aria-hidden="true" /> Explore projects</Button>
            <Button href="#contact" variant="outline"><Mail aria-hidden="true" /> Get in touch</Button>
          </div>
          <div class="hero-socials" aria-label="Social profiles">
            <a href={profile.github}><Github aria-hidden="true" /> GitHub</a>
            <a href={profile.linkedin}><Linkedin aria-hidden="true" /> LinkedIn</a>
          </div>
        </div>
        <IdentityIllustration />
      </div>
    </section>
    <ProjectGallery />
    <section id="skills" class="section">
      <div class="section-head">
        <h2>Tech Stack</h2>
      </div>
      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.name}</h3>
            <div class="tags">
              {group.technologies.map((name) => (
                <TechTag name={name} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
    <GitHubStats />
    {experiences.length > 0 && (
      <section id="experience" class="section">
        <div class="section-head">
          <h2>Experience</h2>
        </div>
        {experiences.map((item) => (
          <article class="timeline-item">
            <span class="meta">{item.period}</span>
            <h3>
              {item.role} · {item.organization}
            </h3>
            <p>{item.description}</p>
          </article>
        ))}
      </section>
    )}
    {certifications.length > 0 && (
      <section id="credentials" class="section">
        <div class="section-head">
          <h2>Certifications &amp; Achievements</h2>
        </div>
        {certifications.map((item) => (
          <article class="timeline-item">
            <span class="meta">
              {item.date} · {item.type}
            </span>
            <h3>{item.title}</h3>
            <p>
              {item.issuer} — {item.description}
            </p>
            {item.credentialUrl && <a href={item.credentialUrl}>View credential ↗</a>}
          </article>
        ))}
      </section>
    )}
    <section id="blog" class="section">
      <div class="section-head">
        <h2>Latest Writing</h2>
        <Button href="/blog" variant="ghost" size="sm">
          All writing <ArrowUpRight aria-hidden="true" />
        </Button>
      </div>
      {recent.length ? (
        <div class="writing-grid">
          {recent.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <span class="empty-icon">
            <Notebook class="size-5" aria-hidden="true" />
          </span>
          <p>
            {blogError
              ? 'Writing is temporarily unavailable. Please try again later.'
              : 'No articles published yet.'}
          </p>
        </div>
      )}
    </section>
    <section id="contact" class="section contact-section">
      <div class="contact-surface">
        <div>
          <h2>Get in touch</h2>
          <p>For messages about my work, reach me on LinkedIn.</p>
        </div>
        <Button href={profile.linkedin}>
          Connect on LinkedIn <ArrowUpRight aria-hidden="true" />
        </Button>
      </div>
    </section>
  </div>
  <script>
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    if (motion.matches && 'IntersectionObserver' in window) {
      const arrivals = new IntersectionObserver((entries, observer) => {
        for (const { target, isIntersecting } of entries) {
          if (!isIntersecting) continue;
          observer.unobserve(target);
          if (motion.matches && !target.matches(':focus-within')) {
            target.animate(
              [{ translate: '0 8px' }, { translate: '0 0' }],
              { duration: 360, easing: 'cubic-bezier(.2,.7,.25,1)' },
            );
          }
        }
      }, { threshold: .08 });
      document.querySelectorAll('.section-head, .skill-group, .project-grid > article, .contact-surface').forEach((item) => arrivals.observe(item));
    }
  </script>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      url: import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321',
      sameAs: [profile.github, profile.linkedin],
      affiliation: { '@type': 'CollegeOrUniversity', name: 'IPB University' },
    }).replace(/</g, '\\u003c')}
  />
</BaseLayout>
