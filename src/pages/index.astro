---
import Card from '../components/starwind/card';
import Briefcase from '@tabler/icons/outline/briefcase.svg';
import Award from '@tabler/icons/outline/award.svg';
import Notebook from '@tabler/icons/outline/notebook.svg';
import { button } from '../components/starwind/button/variants';
import Button from '../components/starwind/button/Button.astro';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Github from '@tabler/icons/outline/brand-github.svg';
import Linkedin from '@tabler/icons/outline/brand-linkedin.svg';
import { listPosts } from '../db/queries/blog';
import PostRow from '../components/blog/PostRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import TechTag from '../components/portfolio/TechTag.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { skills } from '../data/skills';
import { experiences } from '../data/experiences';
import { certifications } from '../data/certifications';
let recent: Awaited<ReturnType<typeof listPosts>>['items'] = [];
let blogError = false;
try {
  recent = (await listPosts({ limit: 3 })).items;
} catch {
  console.error('Recent articles unavailable');
  blogError = true;
}
---

<BaseLayout>
  <div class="portfolio">
    <section id="about" class="hero">
      <div class="hero-heading">
        <h1>
          {profile.name}
          <span class="hero-heading-detail">
            Software Engineering
            <br class="desktop-break" /> &amp; Cybersecurity
          </span>
        </h1>
        <img
          class="avatar"
          src={profile.avatar}
          width="144"
          height="144"
          alt="Anas Nasuha profile image"
          fetchpriority="high"
        />
      </div>
      <p class="intro-copy">{profile.introduction}</p>
      <div class="hero-bottom">
        <div class="actions">
          <Button href="#projects">
            Explore projects <ArrowRight aria-hidden="true" />
          </Button>
          <Button href="#contact" variant="outline">
            Get in touch <ArrowUpRight aria-hidden="true" />
          </Button>
        </div>
        <div class="hero-socials" aria-label="Social profiles">
          <Button href={profile.github} variant="ghost" size="sm">
            <Github aria-hidden="true" /> GitHub
          </Button>
          <Button href={profile.linkedin} variant="ghost" size="sm">
            <Linkedin aria-hidden="true" /> LinkedIn
          </Button>
        </div>
      </div>
    </section>
    <section id="skills" class="section">
      <div class="section-head">
        <h2>Technical Skills</h2>
      </div>
      <div class="skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.name}</h3>
            <div class="tags">
              {group.technologies.map((name) => (
                <TechTag name={name} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
    <section id="projects" class="section">
      <div class="section-head">
        <h2>Selected Projects</h2>
      </div>
      <div class="project-grid">
        {[...projects]
          .sort((a, b) => a.order - b.order)
          .map((project) => (
            <ProjectCard project={project} />
          ))}
      </div>
    </section>
    <section id="experience" class="section">
      <div class="section-head">
        <h2>Experience</h2>
      </div>
      {experiences.length ? (
        experiences.map((item) => (
          <article class="timeline-item">
            <span class="meta">{item.period}</span>
            <h3>
              {item.role} · {item.organization}
            </h3>
            <p>{item.description}</p>
          </article>
        ))
      ) : (
        <Card.Root class="milestone-empty">
          <Card.Content>
            <span class="empty-icon">
              <Briefcase class="size-5" aria-hidden="true" />
            </span>
            <p>My work so far is best explored through the projects above.</p>
            <a href="#projects" class="text-link">
              Explore the projects <ArrowUpRight aria-hidden="true" />
            </a>
          </Card.Content>
        </Card.Root>
      )}
    </section>
    <section id="credentials" class="section">
      <div class="section-head">
        <h2>Certifications &amp; Achievements</h2>
      </div>
      {certifications.length ? (
        certifications.map((item) => (
          <article class="timeline-item">
            <span class="meta">
              {item.date} · {item.type}
            </span>
            <h3>{item.title}</h3>
            <p>
              {item.issuer} — {item.description}
            </p>
            {item.credentialUrl && <a href={item.credentialUrl}>View credential ↗</a>}
          </article>
        ))
      ) : (
        <Card.Root class="milestone-empty">
          <Card.Content>
            <span class="empty-icon">
              <Award class="size-5" aria-hidden="true" />
            </span>
            <p>No certifications or achievements listed yet.</p>
          </Card.Content>
        </Card.Root>
      )}
    </section>
    <section id="blog" class="section">
      <div class="section-head">
        <h2>Latest Writing</h2>
        <Button href="/blog" variant="ghost" size="sm">
          All writing <ArrowUpRight aria-hidden="true" />
        </Button>
      </div>
      {recent.length ? (
        <div class="writing-grid">
          {recent.map((post) => (
            <PostRow post={post} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <span class="empty-icon">
            <Notebook class="size-5" aria-hidden="true" />
          </span>
          <p>
            {blogError
              ? 'Writing is temporarily unavailable. Please try again later.'
              : 'Software, security, and lessons learned while building. Notes will appear here as they are published.'}
          </p>
        </div>
      )}
    </section>
    <section id="contact" class="section contact-section">
      <div class="contact-surface">
        <h2>Contact</h2>
        <p>
          Have a project to discuss or something interesting to share? Find me on GitHub or connect
          on LinkedIn.
        </p>
        <div class="actions">
          <a class={button({ variant: 'primary' })} href={profile.linkedin}>
            Connect on LinkedIn ↗
          </a>
          <a class={button({ variant: 'outline' })} href={profile.github}>
            Find me on GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      url: import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321',
      sameAs: [profile.github, profile.linkedin],
      affiliation: { '@type': 'CollegeOrUniversity', name: 'IPB University' },
    }).replace(/</g, '\\u003c')}
  />
</BaseLayout>
