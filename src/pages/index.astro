---
import Button from '../components/starwind/button/Button.astro';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import Github from '@tabler/icons/outline/brand-github.svg';
import Linkedin from '@tabler/icons/outline/brand-linkedin.svg';
import { listPosts } from '../db/queries/blog';
import PostRow from '../components/blog/PostRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import TechTag from '../components/portfolio/TechTag.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { skills } from '../data/skills';
import { experiences } from '../data/experiences';
import { certifications } from '../data/certifications';
let recent: Awaited<ReturnType<typeof listPosts>>['items'] = [];
let blogError = false;
try {
  recent = (await listPosts({ limit: 3 })).items;
} catch {
  console.error('Recent articles unavailable');
  blogError = true;
}
---

<BaseLayout>
  <div class="portfolio">
    <section id="about" class="hero">
      <div class="hero-identity">
        <img
          class="avatar"
          src={profile.avatar}
          width="88"
          height="88"
          alt="Portrait of Anas Nasuha"
          fetchpriority="high"
        />
        <div>
          <span class="eyebrow">Hello, I'm Anas</span>
          <span class="hero-role">Computer Science Student at IPB University</span>
        </div>
      </div>
      <h1>
        {profile.name}
        <span class="hero-heading-detail">
          Software Engineering
          <br class="desktop-break" /> &amp; Cybersecurity.
        </span>
      </h1>
      <p class="intro-copy">{profile.introduction}</p>
      <div class="hero-bottom">
        <div class="actions">
          <Button href="#projects">
            Explore projects <ArrowRight aria-hidden="true" />
          </Button>
          <Button href="#contact" variant="outline">
            Get in touch <ArrowUpRight aria-hidden="true" />
          </Button>
        </div>
        <div class="hero-socials" aria-label="Social profiles">
          <Button href={profile.github} variant="ghost" size="sm">
            <Github aria-hidden="true" /> GitHub
          </Button>
          <Button href={profile.linkedin} variant="ghost" size="sm">
            <Linkedin aria-hidden="true" /> LinkedIn
          </Button>
        </div>
      </div>
      <div class="hero-footnote">
        <span class="status-dot" aria-hidden="true"></span> Building with curiosity. Learning by
        doing.<span class="meta">SCROLL TO EXPLORE ↓</span>
      </div>
    </section>
    <div>
      <section id="skills" class="section">
        <div class="section-head">
          <div>
            <span class="eyebrow">The toolkit</span>
            <h2>Technical skills</h2>
          </div>
          <span class="meta">Always evolving</span>
        </div>
        <div class="skills-grid">
          {skills.map((group) => (
            <div class="skill-group">
              <h3>{group.name}</h3>
              <div class="tags">
                {group.technologies.map((name) => (
                  <TechTag name={name} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
      <section id="projects" class="section">
        <div class="section-head">
          <h2>Selected projects</h2>
          <span class="meta">01 — 06</span>
        </div>
        <p>A selection of things I've been building and exploring.</p>
        <div class="project-grid">
          {[...projects]
            .sort((a, b) => a.order - b.order)
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </section>
      <section id="experience" class="section">
        <div class="section-head">
          <h2>Experience</h2>
          <span class="meta">Along the way</span>
        </div>
        {experiences.length ? (
          experiences.map((item) => (
            <article class="post-row">
              <span class="meta">{item.period}</span>
              <h3>
                {item.role} · {item.organization}
              </h3>
              <p>{item.description}</p>
            </article>
          ))
        ) : (
          <div class="empty">
            <p>
              My work so far is best explored through the projects above. More of the journey will
              be documented here.
            </p>
          </div>
        )}
      </section>
      <section id="credentials" class="section">
        <div class="section-head">
          <h2>Certifications & achievements</h2>
        </div>
        {certifications.length ? (
          certifications.map((item) => (
            <article class="post-row">
              <span class="meta">
                {item.date} · {item.type}
              </span>
              <h3>{item.title}</h3>
              <p>
                {item.issuer} — {item.description}
              </p>
              {item.credentialUrl && <a href={item.credentialUrl}>View credential ↗</a>}
            </article>
          ))
        ) : (
          <div class="empty">
            <p>A space for milestones, as they happen.</p>
          </div>
        )}
      </section>
      <section id="blog" class="section">
        <div class="section-head">
          <h2>Notes from the process</h2>
          <a href="/blog">All writing ↗</a>
        </div>
        {recent.length ? (
          recent.map((post) => <PostRow post={post} />)
        ) : (
          <div class="empty">
            <p>
              {blogError
                ? 'Writing is temporarily unavailable. Please try again later.'
                : 'Software, security, and lessons learned while building. Notes will appear here as they are published.'}
            </p>
          </div>
        )}
      </section>
      <section id="contact" class="section">
        <span class="eyebrow">Keep in touch</span>
        <h2>
          Good conversations start
          <br />
          with a simple hello.
        </h2>
        <p>
          Have a project to discuss or something interesting to share? Find me on GitHub or connect
          on LinkedIn.
        </p>
        <div class="actions">
          <a class="button primary" href={profile.linkedin}>
            Connect on LinkedIn ↗
          </a>
          <a class="button secondary" href={profile.github}>
            Find me on GitHub ↗
          </a>
        </div>
      </section>
    </div>
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      url: import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321',
      sameAs: [profile.github, profile.linkedin],
      affiliation: { '@type': 'CollegeOrUniversity', name: 'IPB University' },
    }).replace(/</g, '\\u003c')}
  />
</BaseLayout>
