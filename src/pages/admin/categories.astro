---
import Input from '@starwind-ui/astro/input';
import AdminLayout from '../../layouts/AdminLayout.astro';
import ConfirmDelete from '../../components/admin/ConfirmDelete.astro';
import Button from '../../components/starwind/Button.astro';
import { listCategories } from '../../db/queries/blog';
const categories = await listCategories();
---

<AdminLayout title="Categories">
  <h1>Organize your ideas.</h1>
  <p>Articles can belong to more than one category. Removing a category preserves its articles.</p>
  <p id="feedback" role="status" aria-live="polite"></p>
  <section class="section">
    <h2>New category</h2>
    <form class="category-form">
      <div class="two-col">
        <div class="field">
          <label for="new-name">Name</label>
          <Input.Root id="new-name" name="name" required maxlength="80" />
        </div>
        <div class="field">
          <label for="new-slug">Slug</label>
          <Input.Root
            id="new-slug"
            name="slug"
            required
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            maxlength="160"
          />
        </div>
      </div>
      <Button type="submit">Create category</Button>
    </form>
  </section>
  {categories.map((c) => (
    <form class="category-form post-row" data-id={c.id}>
      <div class="two-col">
        <div class="field">
          <label for={`name-${c.id}`}>Name</label>
          <Input.Root id={`name-${c.id}`} name="name" value={c.name} required maxlength="80" />
        </div>
        <div class="field">
          <label for={`slug-${c.id}`}>Slug</label>
          <Input.Root
            id={`slug-${c.id}`}
            name="slug"
            value={c.slug}
            required
            maxlength="160"
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
          />
        </div>
      </div>
      <div class="actions">
        <Button type="submit" variant="secondary">
          Save changes
        </Button>
        <ConfirmDelete id={c.id} title={c.name} kind="categories" />
      </div>
    </form>
  ))}
</AdminLayout>
<script>
  const feedback = document.querySelector('#feedback')!;
  async function mutate(body: unknown, method = 'POST') {
    feedback.textContent = 'Saving…';
    try {
      const r = await fetch('/api/admin/categories', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const result = await r.json();
      if (!r.ok) throw Error(result.error);
      location.reload();
    } catch (e) {
      feedback.textContent = e instanceof Error ? e.message : 'Request failed.';
    }
  }
  document.querySelectorAll<HTMLFormElement>('.category-form').forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      void mutate({ id: form.dataset.id, name: data.get('name'), slug: data.get('slug') });
    }),
  );
</script>
