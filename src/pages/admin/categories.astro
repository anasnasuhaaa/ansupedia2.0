---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ConfirmDelete from '../../components/admin/ConfirmDelete.astro';
import CategoryDialog from '../../components/admin/CategoryDialog.astro';
import Table from '../../components/starwind/table';
import Badge from '../../components/starwind/badge/Badge.astro';
import Input from '../../components/starwind/input/Input.astro';
import Button from '../../components/starwind/button/Button.astro';
import Search from '@tabler/icons/outline/search.svg';
import { listCategoryStats } from '../../db/queries/blog';
const all = await listCategoryStats();
const q = (Astro.url.searchParams.get('q') || '').slice(0, 80);
const categories = all.filter((c) => `${c.name} ${c.slug}`.toLowerCase().includes(q.toLowerCase()));
---

<AdminLayout title="Categories">
  <header class="section-head admin-page-heading">
    <div>
      <h1>Categories</h1>
      <p>Articles can belong to more than one category.</p>
    </div>
    <CategoryDialog />
  </header>
  <form class="filters admin-filters" role="search">
    <div class="search-field">
      <Search class="size-4" aria-hidden="true" />
      <label class="sr-only" for="category-search">
        Search categories
      </label>
      <Input id="category-search" type="search" name="q" value={q} placeholder="Find a category…" />
    </div>
    <Button type="submit" variant="outline" size="sm">
      Search
    </Button>
    {q && (
      <Button href="/admin/categories" variant="ghost" size="sm">
        Reset
      </Button>
    )}
  </form>
  {categories.length ? (
    <div class="table-panel">
      <Table.Root class="editorial-table category-table" aria-label="Categories">
        <Table.Header>
          <Table.Row>
            <Table.Head>Name</Table.Head>
            <Table.Head>Slug</Table.Head>
            <Table.Head>Articles</Table.Head>
            <Table.Head class="text-right">Actions</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {categories.map((c) => (
            <Table.Row>
              <Table.Cell class="table-title">{c.name}</Table.Cell>
              <Table.Cell data-label="Slug">
                <code class="meta">{c.slug}</code>
              </Table.Cell>
              <Table.Cell data-label="Articles">
                <Badge variant="outline" class="category-badge">
                  {c.articleCount} {c.articleCount === 1 ? 'article' : 'articles'}
                </Badge>
              </Table.Cell>
              <Table.Cell class="table-actions">
                <div class="actions">
                  <CategoryDialog category={c} />
                  <ConfirmDelete id={c.id} title={c.name} kind="categories" />
                </div>
              </Table.Cell>
            </Table.Row>
          ))}
        </Table.Body>
      </Table.Root>
    </div>
  ) : (
    <div class="empty">
      <h2>{q ? 'No matching categories.' : 'Give your ideas a home.'}</h2>
      <p>
        {q
          ? 'Try another search.'
          : 'Create your first category to help readers discover related writing.'}
      </p>
    </div>
  )}
  <p class="admin-help">
    Deleting a category only removes its article associations. Your articles are always kept.
  </p>
</AdminLayout>
