---
import Input from '@starwind-ui/astro/input';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ConfirmDelete from '../../../components/admin/ConfirmDelete.astro';
import Button from '../../../components/starwind/Button.astro';
import { listPosts } from '../../../db/queries/blog';
const q = Astro.url.searchParams.get('q') || '';
const status = Astro.url.searchParams.get('status');
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const result = await listPosts({
  admin: true,
  q,
  status: status === 'draft' || status === 'published' ? status : undefined,
  page,
});
const pageUrl = (p: number) =>
  `/admin/posts?${new URLSearchParams({ q, status: status || '', page: String(p) })}`;
---

<AdminLayout title="Articles">
  <div class="section-head">
    <h1>Your writing.</h1>
    <a class="button primary" href="/admin/posts/new">
      New article
    </a>
  </div>
  <form class="filters">
    <label class="sr-only" for="q">
      Search articles
    </label>
    <Input.Root id="q" name="q" type="search" value={q} placeholder="Search by title" />
    <label class="sr-only" for="status">
      Status
    </label>
    <select name="status" id="status">
      <option value="">All statuses</option>
      <option value="draft" selected={status === 'draft'}>
        Draft
      </option>
      <option value="published" selected={status === 'published'}>
        Published
      </option>
    </select>
    <Button type="submit">Filter</Button>
  </form>
  <p id="feedback" role="status"></p>
  {result.items.length ? (
    result.items.map((post) => (
      <article class="post-row">
        <span class="meta">
          {post.status} · Updated {post.updatedAt.toLocaleDateString('en-US')}
        </span>
        <div class="section-head">
          <h2>
            <a href={`/admin/posts/${post.id}`}>{post.title}</a>
          </h2>
          <div class="actions">
            <a class="button secondary" href={`/admin/posts/${post.id}`}>
              Edit
            </a>
            {post.status === 'published' && (
              <a class="button secondary" href={`/blog/${post.slug}`}>
                View
              </a>
            )}
            <ConfirmDelete id={post.id} title={post.title} kind="posts" />
          </div>
        </div>
      </article>
    ))
  ) : (
    <div class="empty">No articles found.</div>
  )}
  {result.pages > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {page > 1 && <a href={pageUrl(page - 1)}>← Previous</a>}
      <span>
        {page} / {result.pages}
      </span>
      {page < result.pages && <a href={pageUrl(page + 1)}>Next →</a>}
    </nav>
  )}
</AdminLayout>
