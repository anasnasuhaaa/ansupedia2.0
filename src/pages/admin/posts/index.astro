---
import Input from '../../../components/starwind/input/Input.astro';
import Select from '../../../components/starwind/native-select';
import Button from '../../../components/starwind/button/Button.astro';
import Search from '@tabler/icons/outline/search.svg';
import Plus from '@tabler/icons/outline/plus.svg';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ArticleTable from '../../../components/admin/ArticleTable.astro';
import PagePagination from '../../../components/site/PagePagination.astro';
import { listPosts } from '../../../db/queries/blog';
const q = (Astro.url.searchParams.get('q') || '').slice(0, 200);
const status = Astro.url.searchParams.get('status');
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const result = await listPosts({
  admin: true,
  q,
  status: status === 'draft' || status === 'published' ? status : undefined,
  page,
});
const pageUrl = (p: number) =>
  `/admin/posts?${new URLSearchParams({ q, status: status || '', page: String(p) })}`;
---

<AdminLayout title="Articles">
  <header class="section-head admin-page-heading">
    <div>
      <h1>Articles</h1>
    </div>
    <Button href="/admin/posts/new" size="sm">
      <Plus aria-hidden="true" />
      New article
    </Button>
  </header>
  <form class="filters admin-filters" role="search">
    <div class="search-field">
      <Search class="size-4" aria-hidden="true" />
      <label class="sr-only" for="q">
        Search articles
      </label>
      <Input id="q" name="q" type="search" value={q} placeholder="Search by title…" />
    </div>
    <label class="sr-only" for="status">
      Status
    </label>
    <Select.Root name="status" id="status">
      <option value="">All statuses</option>
      <option value="draft" selected={status === 'draft'}>
        Draft
      </option>
      <option value="published" selected={status === 'published'}>
        Published
      </option>
    </Select.Root>
    <Button type="submit" size="sm">
      Filter
    </Button>
    {(q || status) && (
      <Button href="/admin/posts" variant="ghost" size="sm">
        Reset
      </Button>
    )}
  </form>
  <div class="writing-heading">
    <span class="meta">
      {result.total} {result.total === 1 ? 'article' : 'articles'}
    </span>
  </div>
  {result.items.length ? (
    <ArticleTable items={result.items} />
  ) : (
    <div class="empty">
      <h2>No articles found.</h2>
      <p>
        {q || status
          ? 'Try a different title or status filter.'
          : 'Your next article starts with a simple idea.'}
      </p>
      <Button href={q || status ? '/admin/posts' : '/admin/posts/new'} variant="outline" size="sm">
        {q || status ? 'Clear filters' : 'Create an article'}
      </Button>
    </div>
  )}
  <PagePagination page={result.page} pages={result.pages} pageUrl={pageUrl} />
</AdminLayout>
