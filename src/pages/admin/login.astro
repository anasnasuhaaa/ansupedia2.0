---
import Input from '../../components/starwind/input/Input.astro';
import Card from '../../components/starwind/card';
import Lock from '@tabler/icons/outline/lock.svg';
import Field from '../../components/starwind/field';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/starwind/button/Button.astro';
import { databaseConfigured } from '../../lib/env';
const configured = databaseConfigured();
---

<BaseLayout title="Admin sign in — Ansupedia" noindex>
  <div class="page login-frame">
    <Card.Root class="login-card">
      <Card.Header>
        <span class="empty-icon">
          <Lock class="size-5" aria-hidden="true" />
        </span>
        <span class="eyebrow">Private workspace</span>
        <h1>Welcome back.</h1>
        <p>Sign in to make room for your next idea.</p>
      </Card.Header>
      <Card.Content>
        {!configured && (
          <p class="notice">The writing workspace is being set up. Please return later.</p>
        )}
        <form id="login">
          <Field.Root class="field">
            <Field.Label for="email">Email</Field.Label>
            <Input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              placeholder="you@example.com"
              required
            />
          </Field.Root>
          <Field.Root class="field">
            <Field.Label for="password">Password</Field.Label>
            <Input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="Your password"
              required
            />
          </Field.Root>
          <Button type="submit" disabled={!configured} class="login-submit">
            Sign in
          </Button>
          <p id="message" role="status" aria-live="polite" class="form-feedback"></p>
        </form>
      </Card.Content>
    </Card.Root>
    <p class="login-note">A quiet space for your words.</p>
  </div>
</BaseLayout>
<script>
  import { toast, redirectWithNotice } from '../../lib/notifications';
  const form = document.querySelector<HTMLFormElement>('#login')!;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button')!;
    const message = document.querySelector('#message')!;
    button.disabled = true;
    message.textContent = 'Signing in…';
    const notice = toast.loading('Signing in…');
    try {
      const data = new FormData(form);
      const response = await fetch('/api/auth/sign-in/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email'), password: data.get('password') }),
      });
      if (response.ok) {
        toast.dismiss(notice);
        redirectWithNotice('/admin', 'signedIn');
      } else {
        message.textContent =
          response.status === 429
            ? 'Too many attempts. Please wait a minute.'
            : 'Sign-in failed. Check your credentials and server configuration.';
        toast.error(message.textContent, { id: notice });
      }
    } catch {
      message.textContent = 'Unable to connect. Try again.';
      toast.error(message.textContent, { id: notice });
    } finally {
      button.disabled = false;
    }
  });
</script>
