---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/starwind/card';
import Button from '../../components/starwind/button/Button.astro';
import ArticleTable from '../../components/admin/ArticleTable.astro';
import Plus from '@tabler/icons/outline/plus.svg';
import Notebook from '@tabler/icons/outline/notebook.svg';
import { listPosts, listCategories } from '../../db/queries/blog';
const [all, published, drafts, categories] = await Promise.all([
  listPosts({ admin: true, limit: 5 }),
  listPosts({ admin: true, status: 'published', limit: 1 }),
  listPosts({ admin: true, status: 'draft', limit: 1 }),
  listCategories(),
]);
---

<AdminLayout>
  <header class="section-head admin-page-heading">
    <div>
      <h1>Your writing, at a glance.</h1>
    </div>
    <Button href="/admin/posts/new" size="sm">
      <Plus aria-hidden="true" />
      New article
    </Button>
  </header>
  <div class="stats">
    {[
      ['Total articles', all.total, '/admin/posts'],
      ['Published', published.total, '/admin/posts?status=published'],
      ['Drafts', drafts.total, '/admin/posts?status=draft'],
      ['Categories', categories.length, '/admin/categories'],
    ].map(([label, value, href]) => (
      <a href={String(href)} class="stat-link">
        <Card.Root class="stat">
          <Card.Content>
            <span class="meta">{label}</span>
            <strong>{value}</strong>
            <span class="stat-caption">Manage {String(label).toLowerCase()} ↗</span>
          </Card.Content>
        </Card.Root>
      </a>
    ))}
  </div>
  <section class="admin-section">
    <div class="section-head">
      <h2>Recent articles</h2>
      <Button href="/admin/posts" variant="ghost" size="sm">
        View all ↗
      </Button>
    </div>
    {all.items.length ? (
      <ArticleTable items={all.items} compact />
    ) : (
      <div class="empty">
        <span class="empty-icon">
          <Notebook class="size-5" aria-hidden="true" />
        </span>
        <h3>Your notebook is ready.</h3>
        <p>Start with a thought, a lesson, or something you built.</p>
        <Button href="/admin/posts/new" variant="outline" size="sm">
          Write your first article
        </Button>
      </div>
    )}
  </section>
</AdminLayout>
