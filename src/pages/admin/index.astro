---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Card from '../../components/starwind/card';
import Button from '../../components/starwind/button/Button.astro';
import ArticleTable from '../../components/admin/ArticleTable.astro';
import Plus from '@tabler/icons/outline/plus.svg';
import Notebook from '@tabler/icons/outline/notebook.svg';
import { editorialOverview } from '../../db/queries/blog';
const { recent, drafts, published, categories } = await editorialOverview();
---

<AdminLayout>
  <header class="section-head admin-page-heading">
    <div>
      <h1>Publishing overview</h1>
    </div>
    <Button href="/admin/posts/new" size="sm">
      <Plus aria-hidden="true" />
      New article
    </Button>
  </header>
  <div class="stats">
    {[
      ['Total articles', published + drafts, '/admin/posts'],
      ['Published', published, '/admin/posts?status=published'],
      ['Drafts', drafts, '/admin/posts?status=draft'],
      ['Categories', categories, '/admin/categories'],
    ].map(([label, value, href]) => (
      <a href={String(href)} class="stat-link">
        <Card.Root class="stat">
          <Card.Content>
            <span class="meta">{label}</span>
            <strong>{value}</strong>
          </Card.Content>
        </Card.Root>
      </a>
    ))}
  </div>
  <section class="admin-section">
    <div class="section-head">
      <h2>Recently edited</h2>
      <Button href="/admin/posts" variant="ghost" size="sm">
        View all ↗
      </Button>
    </div>
    {recent.length ? (
      <ArticleTable items={recent} compact />
    ) : (
      <div class="empty">
        <span class="empty-icon">
          <Notebook class="size-5" aria-hidden="true" />
        </span>
        <h3>No articles yet</h3>

        <Button href="/admin/posts/new" variant="outline" size="sm">
          Write your first article
        </Button>
      </div>
    )}
  </section>
</AdminLayout>
