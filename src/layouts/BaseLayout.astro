---
import '@fontsource-variable/geist';
import '@fontsource-variable/manrope';
import '@fontsource-variable/geist-mono';
import '../styles/starwind.css';
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import { ThemeInitScript } from '@starwind-ui/astro/theme';
interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  noindex?: boolean;
  article?: boolean;
}
const {
  title = 'Anas Nasuha — Software & curiosity',
  description = 'Computer Science student at IPB University, exploring software engineering, cybersecurity, and the space between.',
  image,
  noindex = false,
  article = false,
} = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInitScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {image && <meta property="og:image" content={new URL(image, site)} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Ansupedia" href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a href="/" class="footer-brand">
            Ansupedia.
          </a>
          <span>© {new Date().getFullYear()} Anas Nasuha</span>
        </div>
        <span class="footer-note">Built with care. Always learning.</span>
        <a href="/rss.xml" class="text-link">
          RSS feed <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
  </body>
</html>
